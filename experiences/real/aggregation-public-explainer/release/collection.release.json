finding"},{"canonical_url":"https://github.com/matuteiglesias/thesis/blob/7265018750db0f96b69efd4048aedad06ad803fc/docs/Aggregation/chapter1_05.md","contributors":["Matías Iglesias"],"facets":{"explainer_section":"Limitations"},"item_id":"repo.thesis:aggregation-limitations","kind":"research-explainer-section","source_ref":{"authority":"repo.thesis","object_id":"docs/Aggregation/chapter1_05.md","url":"https://github.com/matuteiglesias/thesis/blob/7265018750db0f96b69efd4048aedad06ad803fc/docs/Aggregation/chapter1_05.md"},"summary":"This experience preserves links to governed source notes and their pinned source commit. It does not replace the research programme, reproduce its full derivations, or claim official statistics or a new causal estimate.","tags":["provenance","limitations"],"title":"Credibility, limitations and provenance"}],"payload_sha256":"e14a4ad79268dee768795f0f2e31620e7ac0ac949346ead251f5bd636308f362","release_id":"sha256:e14a4ad79268dee7","schema_id":"knowledge.collection-release","schema_version":1,"source":{"adapter":"jsonl","authority":"repo.thesis","path":"source/items.jsonl","release_id":"git:7265018750db0f96b69efd4048aedad06ad803fc","sha256":"100bf98b0f0df05c6a735dbed58c5b3826528c61100da15d2f65ab242f415535"},"spec_sha256":"571ef07ddf2a3df47524679c32ba2ab921e3b70aeecba0f17a3e9657918ac7ef","title":"Why can individual shocks move the aggregate?"}
