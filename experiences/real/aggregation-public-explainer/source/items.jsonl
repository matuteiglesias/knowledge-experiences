{"item_id":"repo.thesis:aggregation-evidence","kind":"research-explainer-section","title":"Evidence and data","summary":"The governed programme links detailed firm-level exports, imports and fluctuations to aggregate outcomes; this release is an explanatory index, not a new empirical estimate.","contributors":["Matías Iglesias"],"tags":["firm-data","evidence"],"facets":{"explainer_section":"Evidence/data"},"canonical_url":"https://github.com/matuteiglesias/thesis/blob/7265018750db0f96b69efd4048aedad06ad803fc/docs/Aggregation/chapter1_02.md","source_ref":{"authority":"repo.thesis","object_id":"docs/Aggregation/chapter1_02.md","url":"https://github.com/matuteiglesias/thesis/blob/7265018750db0f96b69efd4048aedad06ad803fc/docs/Aggregation/chapter1_02.md"}}
