{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge.experience-release@1",
  "title": "knowledge.experience-release@1",
  "type": "object",
  "required": ["schema_id", "schema_version", "experience_id", "release_id", "collection", "renderer", "artifacts"],
  "properties": {
    "schema_id": {"const": "knowledge.experience-release"},
    "schema_version": {"const": 1},
    "experience_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "collection": {"type": "object"},
    "renderer": {"type": "object"},
    "artifacts": {"type": "array", "items": {"type": "object"}}
  }
}
