{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge.collection-spec@1",
  "title": "knowledge.collection-spec@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "collection_id", "title", "source"],
  "properties": {
    "schema_id": {"const": "knowledge.collection-spec"},
    "schema_version": {"const": 1},
    "collection_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "path", "authority"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "release_id": {"type": ["string", "null"]}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["all", "ids", "facets"]},
        "item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "facets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        }
      }
    }
  }
}
